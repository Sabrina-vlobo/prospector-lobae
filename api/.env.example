# Copie para api/.env e preencha. O .env NUNCA vai pro git.

# Postgres do docker-compose (porta 5434 no host)
DATABASE_URL="postgresql://lobae:lobae@localhost:5434/prospector?schema=public"

API_PORT=3333

# ---------- Google Places API (New) — Fase 1 ----------
GOOGLE_PLACES_API_KEY=""
# Freio de gastos: máximo de chamadas pagas ao Google por mês (o app recusa depois disso).
GOOGLE_MONTHLY_CALL_LIMIT=200
# Máximo de páginas por busca (1 página = 1 chamada = até 20 negócios; teto do Google é 3).
GOOGLE_MAX_PAGES_PER_SEARCH=3
# Buscar avaliações de um negócio (Place Details) — usado ao qualificar. Cota grátis menor que a da busca.
GOOGLE_DETAILS_MONTHLY_LIMIT=100

# ---------- Claude — Fase 3 ----------
ANTHROPIC_API_KEY=""
# Modelo usado na qualificação. Haiku = o mais barato. Troque por claude-sonnet-5-5 se quiser mensagens melhores.
ANTHROPIC_MODEL="claude-haiku-5-5"
# Freio de gastos: máximo de qualificações com IA por mês.
ANTHROPIC_MONTHLY_CALL_LIMIT=300
# Máximo de leads por "Qualificar selecionados".
QUALIFY_BATCH_MAX=10
